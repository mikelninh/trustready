# Never commit real values. Configure these in the deployment environment.
STRIPE_SECRET_KEY=sk_live_or_test_here
TRUSTREADY_TOKEN_SECRET=generate_a_long_random_secret
TRUSTREADY_APP_ORIGIN=https://your-trustready-domain.example

# Optional. If omitted, Checkout creates recurring inline price_data at €49/€249.
# Stable Price IDs are preferred later for plan changes, analytics and portal upgrades.
STRIPE_PRICE_DEVELOPER=price_...
STRIPE_PRICE_TEAM=price_...

# Optional future hard usage-meter integration.
STRIPE_METER_EVENT_NAME=trustready_api_units
