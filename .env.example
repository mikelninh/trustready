# Never commit real values. Configure these in the deployment environment.
STRIPE_SECRET_KEY=sk_live_or_test_here
TRUSTREADY_TOKEN_SECRET=generate_a_long_random_secret
TRUSTREADY_APP_ORIGIN=https://your-trustready-domain.example

# Optional. If omitted, Checkout creates recurring inline price_data at €49/€249.
# Stable Price IDs are preferred later for plan changes, analytics and portal upgrades.
STRIPE_PRICE_DEVELOPER=price_...
STRIPE_PRICE_TEAM=price_...

# Optional future hard usage-meter integration.
STRIPE_METER_EVENT_NAME=trustready_api_units

# -----------------------------------------------------------------------------
# TrustReady Legal client-portal pilot
# -----------------------------------------------------------------------------
# Do not enable real mandate data merely by setting these variables. The real-data
# promotion gate also requires live infrastructure evidence + legal/privacy approval
# + independent security assurance documented in docs/BAO_PRODUCTION_PILOT_PLAN.md.
TRUSTREADY_LEGAL_PILOT_MODE=synthetic
TRUSTREADY_LEGAL_TENANT=firm_bao_pilot
TRUSTREADY_LEGAL_ORIGIN=https://legal.example.invalid

# Production secret sources should come from the approved cloud secret manager,
# never from committed env files.
TRUSTREADY_SESSION_SIGNING_KEY_REF=projects/.../locations/europe-west3/keyRings/.../cryptoKeys/...
TRUSTREADY_INVITE_PEPPER_SECRET_REF=projects/.../secrets/...
TRUSTREADY_SECOND_FACTOR_PROVIDER=disabled_until_reviewed

# Protected PostgreSQL metadata store / approved equivalent.
TRUSTREADY_DATABASE_URL_SECRET_REF=projects/.../secrets/trustready-legal-db-url

# Private document storage. Uploads enter quarantine first and are promoted only
# after clean malware/content validation.
TRUSTREADY_QUARANTINE_BUCKET=replace-after-provisioning
TRUSTREADY_MATTER_BUCKET=replace-after-provisioning
TRUSTREADY_EVIDENCE_BUCKET=replace-after-provisioning
TRUSTREADY_MAX_UPLOAD_BYTES=26214400
TRUSTREADY_ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png

# Real client upload / real mandate data must stay disabled until the external
# promotion gates are accepted.
TRUSTREADY_REAL_MANDATE_DATA_ENABLED=false
TRUSTREADY_HUMAN_APPROVED_SEND_ENABLED=false