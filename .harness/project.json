{
  "schema": "mikel-harness-project-v0.1",
  "project": {
    "name": "TrustReady",
    "repository": "mikelninh/trustready",
    "purpose": "Evidence-first assurance and control layer for bounded AI systems and sensitive workflows."
  },
  "sources_of_truth": [
    {"area": "product", "paths": ["README.md", "docs/ENDGOAL.md"]},
    {"area": "trust_model", "paths": ["docs/TRUST_MODEL.md", "core/"]},
    {"area": "legal_pilot", "paths": ["docs/BAO_PRODUCTION_PILOT_PLAN.md", "docs/CLIENT_PORTAL_SECURITY_ARCHITECTURE.md", "infra/"]},
    {"area": "controls", "paths": ["profiles/", "collectors/"]},
    {"area": "verification", "paths": ["benchmarks/", ".github/workflows/"]},
    {"area": "work_state", "paths": [".harness/"]}
  ],
  "roles": ["chief", "scout", "builder", "verifier", "operator"],
  "commands": {
    "harness_check": ["node scripts/harness-check.mjs"],
    "quick_verification": ["npm test", "npm run benchmark:scanner", "npm run readiness:bao"],
    "full_ci_reference": [".github/workflows/ci.yml"]
  },
  "sensors": {
    "claims": ["evidence mapping", "freshness", "supported/missing/stale/unknown"],
    "security": ["deterministic policy tests", "egress gates", "promotion boundary"],
    "legal_pilot": ["readiness gate", "external verdict separation", "audit request pack"],
    "scanner": ["labelled benchmark", "reproducible observations", "remediation path"]
  },
  "action_policy": {
    "A0": {"meaning": "observe", "approval_required": false},
    "A1": {"meaning": "local_reversible", "approval_required": false},
    "A2": {"meaning": "shared_reversible", "approval_required": false},
    "A3": {"meaning": "consequential", "approval_required": true},
    "A4": {"meaning": "high_impact", "approval_required": true}
  },
  "retry_policy": {"max_retries": 3, "escalate_on_same_failure": 2},
  "receipt_dir": ".harness/receipts",
  "failure_upgrade_required": true
}
